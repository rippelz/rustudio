<Item class="ServerScriptService" referent="ServerScriptService"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Script" referent="server"><Properties><string name="Name">server</string><ProtectedString name="Source">local Players = game:GetService("Players")
local terrain = workspace.Terrain
terrain:FillBlock(CFrame.new(16, 46, 0), Vector3.new(8, 8, 8), Enum.Material.Grass)
terrain:FillBlock(CFrame.new(1024, 46, 0), Vector3.new(8, 8, 8), Enum.Material.Grass)

local function probe(player)
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")
    root.Anchored = true
    root.CFrame = CFrame.new(0, 55, 0)
    task.wait(2)
    local model = workspace.PerPlayerDistant
    local ok, err = pcall(function()
        model:AddPersistentPlayer(player)
        print("STREAM server persisted", #model:GetPersistentPlayers())
    end)
    if not ok then print("STREAM persist error", err) end
    task.wait(1)
    model:RemovePersistentPlayer(player)
    print("STREAM server removed persistent", #model:GetPersistentPlayers())
    task.wait(1)
    local before = time()
    ok, err = pcall(function() player:RequestStreamAroundAsync(Vector3.new(1024, 55, 0), 2) end)
    print("STREAM server request", ok, time() - before, err)
    task.wait(1)
    root.CFrame = CFrame.new(1024, 55, 0)
    task.wait(2)
    root.CFrame = CFrame.new(0, 55, 0)
    player.ReplicationFocus = workspace.Focus
    task.wait(2)
    player.ReplicationFocus = nil
end
Players.PlayerAdded:Connect(probe)
for _, player in Players:GetPlayers() do task.spawn(probe, player) end
