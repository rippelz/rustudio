<Item class="LocalScript" referent="client"><Properties><string name="Name">client</string><ProtectedString name="Source">local player = game:GetService("Players").LocalPlayer
local start = time()
local function log(...)
    print("STREAM", string.format("%.3f", time() - start), ...)
end
local function relevant(instance)
    return instance.Name:match("^Ring%d+$") or instance.Name:match("Distant$") or instance.Name == "FocusNeighbor"
end
local first
workspace.DescendantAdded:Connect(function(instance)
    if instance.Name == "Ring32" and first then log("same identity", instance == first) end
    if relevant(instance) then log("add", instance.Name) end
end)
workspace.DescendantRemoving:Connect(function(instance)
    if relevant(instance) then log("remove", instance.Name) end
end)
player:GetPropertyChangedSignal("GameplayPaused"):Connect(function() log("paused", player.GameplayPaused) end)
workspace.PersistentLoaded:Connect(function() log("persistent loaded") end)
task.spawn(function()
    first = workspace:WaitForChild("Ring32", 3)
    log("wait near", first ~= nil)
end)
task.spawn(function() log("wait far", workspace:WaitForChild("Ring1536", 2) ~= nil) end)
local function sample()
    local visible = {}
    for _, instance in workspace:GetChildren() do
        if relevant(instance) then table.insert(visible, instance.Name) end
    end
    table.sort(visible)
    local function hasTerrain(x)
        local _, occupancy = workspace.Terrain:ReadVoxels(
            Region3.new(Vector3.new(x, 44, 0), Vector3.new(x + 4, 48, 4)), 4)
        return occupancy[1][1][1] &gt; 0
    end
    local names = {}
    for _, name in {"Default", "Atomic", "Persistent", "PerPlayer", "Nonatomic"} do
        local model = workspace:FindFirstChild(name)
        if model then table.insert(names, name .. "=" .. #model:GetChildren()) end
    end
    log("sample", table.concat(visible, ","), table.concat(names, ","), hasTerrain(16), hasTerrain(1024))
end
sample()
for i = 1, 24 do
    task.wait(0.5)
    sample()
end
log("done")
