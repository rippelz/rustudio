<Item class="ServerScriptService" referent="ServerScriptService"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Script" referent="server"><Properties><string name="Name">server</string><ProtectedString name="Source">local Players = game:GetService("Players")
local function probe(player)
    local root = (player.Character or player.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
    root.Anchored = true
    root.CFrame = CFrame.new(0, 55, 0)
end
Players.PlayerAdded:Connect(probe)
for _, player in Players:GetPlayers() do task.spawn(probe, player) end
</ProtectedString></Properties>
</Item>
</Item>
<Item class="StarterPlayer" referent="StarterPlayer"><Properties><string name="Name">StarterPlayer</string><bool name="LoadCharacterAppearance">false</bool></Properties>
<Item class="StarterPlayerScripts" referent="StarterPlayerScripts"><Properties><string name="Name">StarterPlayerScripts</string></Properties>
<Item class="LocalScript" referent="client"><Properties><string name="Name">client</string><ProtectedString name="Source">task.wait(3)
local cells = {}
for _, i in workspace:GetChildren() do
    if i.Name:match("^Cell_") then table.insert(cells, i.Name:sub(6)) end
end
table.sort(cells)
print("STREAM grid", #cells, table.concat(cells, " "))
</ProtectedString></Properties>
</Item>
</Item>
</Item>
